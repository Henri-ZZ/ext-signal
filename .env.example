# Neon PostgreSQL 连接串。与 ext-probe 共用同一个数据库。
# 需要 sslmode=require，不要提交真实值。
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# ext-probe Worker 的公开地址与手动触发密钥，用于「Track now」按钮。
# 不配置时按钮会提示未配置，其余功能不受影响。
EXT_PROBE_URL="https://ext-probe.<your-subdomain>.workers.dev"
EXT_PROBE_TOKEN=""
