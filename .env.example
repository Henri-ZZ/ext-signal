# Neon PostgreSQL 连接串。与 ext-probe 共用同一个数据库。
# 需要 sslmode=require，不要提交真实值。
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Neon Auth（Managed Better Auth）。
#
# NEON_AUTH_BASE_URL：Neon 控制台 → 你的 branch → Auth → Configuration 里的 Auth URL，
#   形如 https://ep-xxx.neonauth.<region>.aws.neon.tech/neondb/auth
# NEON_AUTH_COOKIE_SECRET：用 `openssl rand -base64 32` 生成，至少 32 字符。
#
# 两者都必须在构建时可用：src/lib/auth/server.ts 在模块加载时校验。
NEON_AUTH_BASE_URL=""
NEON_AUTH_COOKIE_SECRET=""

# ext-probe Worker 的公开地址与手动触发密钥，用于「Track now」按钮。
# 不配置时按钮会提示未配置，其余功能不受影响。
EXT_PROBE_URL="https://ext-probe.<your-subdomain>.workers.dev"
EXT_PROBE_TOKEN=""
